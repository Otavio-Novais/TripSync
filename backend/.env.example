# Copie para backend/.env e ajuste os valores.

# Desenvolvimento local
DEBUG=True
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Banco: SQLite local ou PostgreSQL (ex.: postgres://user:senha@host:5432/tripsync)
DATABASE_URL=sqlite:///db.sqlite3

# Produção (exemplo)
# DEBUG=False
# ALLOWED_HOSTS=meu-backend.herokuapp.com
# CORS_ALLOWED_ORIGINS=https://meu-frontend.herokuapp.com
# CSRF_TRUSTED_ORIGINS=https://meu-backend.herokuapp.com

# Email (opcional; sem isso os emails são impressos no console)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
